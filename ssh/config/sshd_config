# Порт SSH (по умолчанию 22, изменен на 2222)
Port 2222

# Отключение входа от имени суперпользователя root
PermitRootLogin no

# Отключение входа по паролю - разрешен только вход по ключу
PasswordAuthentication no

# Отключение пустых паролей
PermitEmptyPasswords no

# Отключение интерактивной аутентификации (клавиатура)
KbdInteractiveAuthentication no

# Основные настройки Postfix

# Доменное имя, которое будет добавляться к адресам
myhostname = mail.example.org

# Домен, для которого сервер принимает почту
mydomain = example.org

# Источник отправляемых писем
myorigin = $mydomain

# На каких интерфейсах слушать (все)
inet_interfaces = all
inet_protocols = ipv4

# Какие сети считаются локальными
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128 192.168.56.0/24

# Куда складывать входящую почту (в формате Maildir или mbox)
# По умолчанию в Ubuntu используется Maildir в домашних папках
home_mailbox = Maildir/

# Настройки для работы с Dovecot (IMAP/POP3)
mailbox_command = /usr/lib/dovecot/deliver
